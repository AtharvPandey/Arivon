# Copy this file to .env and fill in your own values.

# For local development, SQLite needs no setup at all.
# When you're ready for production, change this to a Postgres URL, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/arivon
DATABASE_URL=sqlite:///./arivon.db

# Used to sign login tokens (JWT). Generate a real random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=1440


